# =============================================================================
# MausamAI — Meteorological & Geospatial API Configurations
# =============================================================================
# Default: MausamAI uses Open-Meteo High-Resolution Numerical Models and
# OpenStreetMap / CartoDB Global Basemaps, which are 100% FREE & REQUIRE NO API KEY.
# 
# (Optional) You can provide your personal API keys below to enable additional
# proprietary radar tile streams and satellite imagery layers:
# =============================================================================

# OpenWeatherMap API Key (Optional - for OWM precipitation radar tiles)
VITE_OPENWEATHER_API_KEY=

# Mapbox Access Token (Optional - for high-resolution satellite imagery basemaps)
VITE_MAPBOX_API_KEY=

# WeatherAPI Key (Optional - for auxiliary marine sounding telemetry)
VITE_WEATHERAPI_KEY=

# IMD Synoptic Doppler Radar Gateway
VITE_IMD_RADAR_ENDPOINT=https://mausam.imd.gov.in

# Application Environment Mode
VITE_APP_ENV=development
